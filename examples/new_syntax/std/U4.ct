// U4 is a native type (no fields). Its size is 1 cell (4 bits).
// += 1 and -= 1 are native operations (compiler emits Inc/Dec ops).
// All other operators are implemented via trait impls below — the
// compiler desugars `a + b` to `Add::add(a, b)`, `a == b` to
// `Eq::eq(a, b)`, and so on.
struct U4 {}

extension U4 {
    fn zero(): Self {
        0
    }

    fn input(): Self {
        System::setRegister<0>(2);
        System::getRegister<2>()
    }

    fn printDec(self) {
        if self > 9 {
            '1'.print();
            mut Self k = self;
            k -= 10;
            k.print();
        } else {
            self.print();
        }
    }

    fn print(self) {
        System::setRegister<1>(3);
        System::setRegister<2>(self);
        System::setRegister<0>(1);
    }
}

// -------- operator impls --------

impl Eq for U4 {
    // Decrement both copies in lock-step; equal iff both reach zero together.
    fn eq(self, U4 other): Bool {
        mut U4 a = self;
        mut U4 b = other;
        loop {
            if a {
                if b {
                    a -= 1;
                    b -= 1;
                } else {
                    return false;
                }
            } else {
                return if b { false } else { true };
            }
        }
    }

    fn ne(self, U4 other): Bool {
        if self.eq(other) { false } else { true }
    }
}

impl Ord for U4 {
    // a > b iff we can still drain `a` after `b` has hit zero.
    fn gt(self, U4 other): Bool {
        mut U4 a = self;
        mut U4 b = other;
        loop {
            if a {
                if b {
                    a -= 1;
                    b -= 1;
                } else {
                    return true;
                }
            } else {
                return false;
            }
        }
    }

    fn lt(self, U4 other): Bool {
        other.gt(self)
    }

    fn ge(self, U4 other): Bool {
        if self.lt(other) { false } else { true }
    }

    fn le(self, U4 other): Bool {
        if self.gt(other) { false } else { true }
    }
}

impl Add for U4 {
    fn add(self, U4 other): Self {
        mut U4 a = self;
        mut U4 b = other;
        loop {
            if b {
                a += 1;
                b -= 1;
            } else {
                return a;
            }
        }
    }
}

impl Sub for U4 {
    fn sub(self, U4 other): Self {
        mut U4 a = self;
        mut U4 b = other;
        loop {
            if b {
                a -= 1;
                b -= 1;
            } else {
                return a;
            }
        }
    }
}

impl AddAssign for U4 {
    fn add_assign(mut self, U4 other) {
        mut U4 b = other;
        loop {
            if b {
                self += 1;
                b -= 1;
            } else {
                return;
            }
        }
    }
}

impl SubAssign for U4 {
    fn sub_assign(mut self, U4 other) {
        mut U4 b = other;
        loop {
            if b {
                self -= 1;
                b -= 1;
            } else {
                return;
            }
        }
    }
}
