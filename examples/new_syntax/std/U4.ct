            13 => match other {
                14..=15 => false,
                _ => true,
            },
            14 => match other {
                15 => false,
                _ => true,
            },
            15 => true,
        }
    }

    fn le(self, U4 other): Bool {
        match self {
            0 => true,
            1 => match other {
                0 => false,
                _ => true,
            },
            2 => match other {
                0..=1 => false,
                _ => true,
            },
            3 => match other {
                0..=2 => false,
