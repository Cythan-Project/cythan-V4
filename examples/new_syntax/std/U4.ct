                _ => false,
            },
            13 => match other {
                14..=15 => true,
                _ => false,
            },
            14 => match other {
                15 => true,
                _ => false,
            },
            15 => false,
        }
    }

    fn ge(self, U4 other): Bool {
        match self {
            0 => match other {
                0 => true,
                _ => false,
            },
            1 => match other {
                0..=1 => true,
                _ => false,
            },
            2 => match other {
                0..=2 => true,
                _ => false,
            },
            3 => match other {
                0..=3 => true,
                _ => false,
            },
            4 => match other {
                0..=4 => true,
                _ => false,
            },
            5 => match other {
                0..=5 => true,
                _ => false,
            },
            6 => match other {
                0..=6 => true,
                _ => false,
            },
            7 => match other {
                8..=15 => false,
                _ => true,
            },
            8 => match other {
                9..=15 => false,
                _ => true,
            },
            9 => match other {
                10..=15 => false,
                _ => true,
