                _ => false,
            },
            7 => match other {
                7 => true,
                _ => false,
            },
            8 => match other {
                8 => true,
                _ => false,
            },
            9 => match other {
                9 => true,
                _ => false,
            },
            10 => match other {
                10 => true,
                _ => false,
            },
            11 => match other {
                11 => true,
                _ => false,
            },
            12 => match other {
                12 => true,
                _ => false,
            },
            13 => match other {
                13 => true,
                _ => false,
            },
            14 => match other {
                14 => true,
                _ => false,
            },
            15 => match other {
                15 => true,
                _ => false,
            },
        }
    }

    fn ne(self, U4 other): Bool {
        match self {
            0 => match other {
                0 => false,
                _ => true,
            },
            1 => match other {
                1 => false,
                _ => true,
            },
            2 => match other {
                2 => false,
                _ => true,
            },
            3 => match other {
                3 => false,
                _ => true,
            },
            4 => match other {
                4 => false,
                _ => true,
            },
            5 => match other {
                5 => false,
                _ => true,
            },
            6 => match other {
                6 => false,
                _ => true,
            },
            7 => match other {
                7 => false,
                _ => true,
            },
            8 => match other {
                8 => false,
                _ => true,
            },
            9 => match other {
                9 => false,
                _ => true,
            },
            10 => match other {
