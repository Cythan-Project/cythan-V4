                _ => true,
            },
            6 => match other {
                0..=6 => false,
                _ => true,
            },
            7 => match other {
                0..=7 => false,
                _ => true,
            },
            8 => match other {
                9..=15 => true,
                _ => false,
            },
            9 => match other {
                10..=15 => true,
                _ => false,
            },
            10 => match other {
                11..=15 => true,
                _ => false,
            },
            11 => match other {
