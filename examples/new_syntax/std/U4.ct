}

impl Ord for U4 {
    fn gt(self, U4 other): Bool {
        match self {
            0 => false,
            1 => match other {
                0 => true,
                _ => false,
            },
            2 => match other {
                0..=1 => true,
                _ => false,
            },
            3 => match other {
                0..=2 => true,
                _ => false,
            },
            4 => match other {
                0..=3 => true,
