// U4 is a native type (no fields). Its size is 1 cell (4 bits).
// += 1 and -= 1 are native operations (compiler emits Inc/Dec ops).
// Operators below dispatch through nested matches over the 16 possible
// cell values, so each binary op is a constant number of HIR Match
// dispatches instead of an O(n) decrement loop. We exploit two
// shortcuts: `match self { 0 => other }` skips the inner table when
// adding zero, and range patterns (`1..=15`) collapse contiguous
// cases.
struct U4 {}

extension U4 {
    fn zero(): Self {
        0
    }

    fn input(): Self {
        System::setRegister<0>(2);
        System::getRegister<2>()
    }

    fn printDec(self) {
        if self > 9 {
            '1'.print();
            mut Self k = self;
            k -= 10;
            k.print();
        } else {
            self.print();
        }
    }

    fn print(self) {
        System::setRegister<1>(3);
        System::setRegister<2>(self);
        System::setRegister<0>(1);
    }
}

// -------- operator impls --------

impl Eq for U4 {
    fn eq(self, U4 other): Bool {
        match self {
            0 => match other {
                0 => true,
                _ => false,
            },
            1 => match other {
                1 => true,
                _ => false,
            },
            2 => match other {
                2 => true,
                _ => false,
            },
            3 => match other {
                3 => true,
                _ => false,
            },
            4 => match other {
                4 => true,
                _ => false,
            },
            5 => match other {
