struct Bool {
    U4 value,
}

extension Bool {
    fn not(self): Self {
        if self {
            false
        } else {
            true
        }
    }

    // Print '1' for true, '0' for false. (The old `"true"`/`"false"` strings
    // required a string-literal lowering path in HIR gen that doesn't exist
    // yet — see the scope notes in Phase 4. The single-digit print routes
    // through U4::print, which IS implemented.)
    fn print(self) {
        self.value.print();
    }
}
