struct Array<T, E, F> {}

extension Array<T, E, F> {
    fn set<N>(mut self, T value) {}
    fn setDyn(mut self, F index, T value) {}
    fn get<N>(self): T {}
    fn getDyn(self, F index): T {}
    fn len(self): F {}

    fn print(Self<U8, E, F> self) {
        mut F index = F::zero();
        loop {
            if self.len() > index {
                self.getDyn(index).print();
                index += 1;
            } else {
                break;
            }
        }
    }

    fn println(Self<U8, E, F> self) {
        mut F index = F::zero();
        loop {
            if self.len() == index {
                break;
            } else {
                self.getDyn(index).print();
                index += 1;
            }
        }
        '\n'.print();
    }

    fn contains(self, T t): Bool {
        mut F size = self.len();
        loop {
            if size == 0 {
                return false;
            }
            size -= 1;
            if self.getDyn(size) == t {
                return true;
            }
        }
    }
}
