// Operator traits. Each binary operator in the language desugars to a
// method call on one of these traits; the compiler looks for an `impl` and
// dispatches through it. These traits are in the compiler's
// `OPERATOR_TRAITS` list, so callers don't need `use Add;` / `use Eq;` to
// use `+` or `==` — the sugar implicitly brings them into scope.
//
// `Add<Output>` and `Sub<Output>` carry an `Output` template parameter
// (the same role as Rust's `type Output`). The common `U4 + U4 -> U4`
// case is just `impl Add<U4> for U4`; custom widenings are just another
// impl with a different `Output`.

trait Eq {
    fn eq(self, Self other): Bool;
    fn ne(self, Self other): Bool;
}

trait Ord {
    fn lt(self, Self other): Bool;
    fn gt(self, Self other): Bool;
    fn le(self, Self other): Bool;
    fn ge(self, Self other): Bool;
}

trait Add<Output> {
    fn add(self, Self other): Output;
}

trait Sub<Output> {
    fn sub(self, Self other): Output;
}

trait AddAssign {
    fn add_assign(mut self, Self other);
}

trait SubAssign {
    fn sub_assign(mut self, Self other);
}
