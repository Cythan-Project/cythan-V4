class TestByte {

    Val main() {
        Byte a = Byte.zero();
        if a.equalsZero() {
            "zero_ok".println();
        } else {
            "zero_fail".println();
        };
        Byte b = Byte.fromVal(5);
        b.inc();
        if b.equals(Byte.fromVal(6)) {
            "inc_ok".println();
        } else {
            "inc_fail".println();
        };
        b.dec();
        b.dec();
        if b.equals(Byte.fromVal(4)) {
            "dec_ok".println();
        } else {
            "dec_fail".println();
        };
        if b.equalsZero() {
            "nz_fail".println();
        } else {
            "nz_ok".println();
        };
        Byte c = Byte.fromVal(3);
        Byte d = Byte.fromVal(2);
        c.add(d);
        if c.equals(Byte.fromVal(5)) {
            "add_ok".println();
        } else {
            "add_fail".println();
        };
        Byte e = Byte.fromVal(7);
        Byte f = Byte.fromVal(3);
        e.sub(f);
        if e.equals(Byte.fromVal(4)) {
            "sub_ok".println();
        } else {
            "sub_fail".println();
        };
        Byte g = Byte.fromValAsNumber(5);
        g.print();
        '\n'.print();
        return 0;
    }
}