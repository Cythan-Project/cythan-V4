class TestArray {

    Val main() {
        Array<Val, 5, Val> arr = Array tmp;
        arr.set<0>(1);
        arr.set<1>(3);
        arr.set<2>(5);
        arr.set<3>(7);
        arr.set<4>(9);
        arr.get<0>().print();
        arr.get<2>().print();
        arr.get<4>().print();
        '\n'.print();
        Val idx = 1;
        arr.getDyn(idx).print();
        '\n'.print();
        arr.setDyn(idx, 8);
        arr.getDyn(idx).print();
        '\n'.print();
        if arr.contains(5) {
            "has5".println();
        } else {
            "no5".println();
        };
        if arr.contains(6) {
            "has6".println();
        } else {
            "no6".println();
        };
        return 0;
    }
}