class TestExpr {

    Val main() {
        Val a = if true {
            5;
        } else {
            9;
        };
        a.print();
        '\n'.print();
        Val b = if false {
            5;
        } else {
            9;
        };
        b.print();
        '\n'.print();
        Bool c = true;
        Val d = if c {
            7;
        } else {
            2;
        };
        d.print();
        '\n'.print();
        Bool e = false;
        Val f = if e {
            1;
        } else {
            4;
        };
        f.print();
        '\n'.print();
        return 0;
    }
}