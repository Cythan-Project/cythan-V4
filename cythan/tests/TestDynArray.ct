class TestDynArray {

    Val main() {
        DynArray<Val, 10, Val> darr = DynArray.new();
        darr.add(3);
        darr.add(7);
        darr.add(1);
        darr.get<0>().print();
        darr.get<1>().print();
        darr.get<2>().print();
        '\n'.print();
        if darr.len().equals(3) {
            "len3".println();
        } else {
            "nlen3".println();
        };
        Val popped = darr.pop();
        popped.print();
        '\n'.print();
        if darr.len().equals(2) {
            "len2".println();
        } else {
            "nlen2".println();
        };
        if darr.contains(7) {
            "has7".println();
        } else {
            "no7".println();
        };
        if darr.contains(9) {
            "has9".println();
        } else {
            "no9".println();
        };
        return 0;
    }
}