class TestCast {

    Val main() {
        Val a = 0;
        Bool b = a as Bool;
        if b {
            "0_is_true".println();
        } else {
            "0_is_false".println();
        };
        Val c = 1;
        Bool d = c as Bool;
        if d {
            "1_is_true".println();
        } else {
            "1_is_false".println();
        };
        Bool e = true;
        Val f = e as Val;
        f.print();
        '\n'.print();
        Bool g = false;
        Val h = g as Val;
        h.print();
        '\n'.print();
        return 0;
    }
}